#!/bin/sh
# Strip machine-attribution trailers from commit messages.
#
# The repository records a single human author. Tool-generated trailers
# (Co-Authored-By, "Generated with ...", Claude-Session) are removed here
# rather than relying on discipline at commit time, so the policy holds even when a commit is made
# by tooling that appends them automatically.
#
# Installed via a LOCAL core.hooksPath (git config core.hooksPath .githooks).
# It is deliberately not global: it must not affect the user's other repos.

set -e
msg_file="$1"
[ -f "$msg_file" ] || exit 0

tmp="${msg_file}.stripped"
grep -viE '^[[:space:]]*(co-authored-by:|generated with |claude-session:)' "$msg_file" > "$tmp" || true

# Collapse the trailing blank lines that stripping tends to leave behind.
awk 'BEGIN{n=0} {lines[NR]=$0} END{last=NR; while(last>0 && lines[last] ~ /^[[:space:]]*$/) last--; for(i=1;i<=last;i++) print lines[i]}' "$tmp" > "$msg_file"
rm -f "$tmp"

if [ ! -s "$msg_file" ]; then
  echo "commit-msg: message is empty after stripping attribution trailers" >&2
  exit 1
fi
exit 0
