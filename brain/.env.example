# Copy to brain/.env and fill in. brain/.env is gitignored and must never be
# committed.

# Reasoning model credential. Groq exposes an OpenAI-compatible endpoint, so it
# is used through the OpenAI-compatible LLMClient implementation rather than a
# bespoke one. See docs/DESIGN.md section 6.7.
GROQ_API_KEY=

# Optional overrides. Defaults are in src/coroner_brain/config.py.
# CORONER_LLM_BASE_URL=https://api.groq.com/openai/v1
# CORONER_MODEL=
# CORONER_LEDGER_PATH=coroner-ledger.sqlite3
# CORONER_ABSTENTION_THRESHOLD=0.5
# Wall clock for one diagnosis, retries included; past it the incident is
# recorded as DISCARDED rather than left hanging.
# CORONER_MODEL_DEADLINE_SECONDS=180

# Output and approval. stdout is the default sink and needs nothing else.
# CORONER_SINK=stdout
# CORONER_PUBLIC_URL=http://localhost:8000
# CORONER_APPROVAL_TTL_SECONDS=1800
# Failure types promoted out of shadow mode, comma separated. Empty means
# every type is in shadow and nothing offers approval. See docs/DESIGN.md 5.5.
# CORONER_PROMOTED_TYPES=
# Parked incidents survive a restart only with Redis.
# CORONER_REDIS_URL=redis://localhost:6379/0
# Shared with the agent, which verifies approval tokens with it.
# CORONER_APPROVAL_SECRET=
# Slack sink, opt-in: CORONER_SINK=slack plus all three of these.
# CORONER_SLACK_BOT_TOKEN=xoxb-...
# CORONER_SLACK_CHANNEL=C0123456789
# CORONER_SLACK_SIGNING_SECRET=
