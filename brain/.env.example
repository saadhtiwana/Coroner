# Copy to brain/.env and fill in. brain/.env is gitignored and must never be
# committed.

# Reasoning model credential. Groq exposes an OpenAI-compatible endpoint, so it
# is used through the OpenAI-compatible LLMClient implementation rather than a
# bespoke one. See docs/DESIGN.md section 6.7.
GROQ_API_KEY=

# Optional overrides. Defaults are in src/coroner_brain/config.py.
# CORONER_LLM_BASE_URL=https://api.groq.com/openai/v1
# CORONER_MODEL=
# CORONER_LEDGER_PATH=coroner-ledger.sqlite3
# CORONER_ABSTENTION_THRESHOLD=0.5
